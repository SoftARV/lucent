/_build/
.cache/
# Symlink to build/compile_commands.json, for clangd. The wlroots protocol
# header is generated into the build dir, so without it an editor reports the
# C shim as a wall of undeclared identifiers that meson compiles fine.
/compile_commands.json
CLAUDE.md

__pycache__/
*.pyc
tools/*.log

# makepkg working dirs and output. It also rewrites pkgver= in place on every
# build; that line is a placeholder for a -git package, so do not commit it.
/packaging/src/
/packaging/pkg/
/packaging/lucent/
/packaging/*.pkg.tar.*
/packaging/*.log
