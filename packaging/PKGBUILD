# Maintainer: Miguel Rincon <miguelaezak@gmail.com>

pkgname=lucent-git
_pkgname=lucent
pkgver=r0.0000000
pkgrel=1
pkgdesc="Razer keyboard lighting and Blade laptop power control for GNOME"
arch=('x86_64')
url="https://github.com/SoftARV/lucent"
license=('GPL-3.0-or-later')

depends=(
  'gtk4'
  'libadwaita'
  'glib2'
  # libwayland-client, for the daemon's wlroots screen backend. The same
  # package also carries wayland-scanner, which generates the protocol
  # bindings at build time, so it is not repeated in makedepends.
  'wayland'
)
makedepends=(
  'git'
  'meson'
  'ninja'
  'vala'
  'blueprint-compiler'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
install="$_pkgname.install"

source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$_pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  arch-meson "$_pkgname" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}

# The udev rule, the systemd user unit, the GSettings schema, the desktop file
# and the icons all install to the paths pacman already has hooks for, so
# reloading udev, reloading the user manager and compiling schemas happen
# without an .install script. What is left is in lucent.install, and it is only
# a message: nothing there can be done for the user without either guessing
# which account wants the service or asking a GUI for root.
