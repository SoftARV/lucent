using Gtk 4.0;
using Adw 1;

template $LucentBatteryPage : Adw.PreferencesPage {

  Adw.PreferencesGroup {
    Adw.ActionRow level_row {
      title: "Battery";
      subtitle: "Unknown";
    }
  }

  Adw.PreferencesGroup limits {
    title: "Charge Limit";

    header-suffix: Image {
      icon-name: "help-about-symbolic";
      valign: center;
      tooltip-text: "Stops charging below full to reduce wear.\n\nThe laptop's firmware holds this itself, so it survives suspend and reboot even when Lucent is not running. It is the same setting the BIOS offers.";

      styles ["dim-label"]
    };

    Adw.SwitchRow limit_row {
      title: "Limit Charging";
    }

    Adw.SpinRow threshold_row {
      title: "Stop Charging At";
      subtitle: "Percent. The firmware accepts 50 to 80.";
      sensitive: false;

      adjustment: Adjustment {
        lower: 50;
        upper: 80;
        step-increment: 5;
        page-increment: 10;
      };
    }
  }

  Adw.PreferencesGroup unavailable {
    visible: false;

    $LucentDaemonNotice notice {}
  }
}
