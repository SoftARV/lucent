using Gtk 4.0;
using Adw 1;

template $LucentPerformancePage : Adw.PreferencesPage {

  Adw.PreferencesGroup profiles {
    title: "Power Mode";

    // The explanation lives in a tooltip rather than a description: it is
    // worth reading once and then only ever in the way.
    header-suffix: Image {
      icon-name: "help-about-symbolic";
      valign: center;
      tooltip-text: "Each power source keeps its own mode. Lucent reapplies it after suspend and at startup, which the laptop's firmware otherwise forgets.\n\nOn battery the graphics power limit is fixed by the firmware, so fewer modes make any difference there.";

      styles ["dim-label"]
    };

    // Models are built in code: the two rows offer different modes, and the
    // stored value has to stay representable even when it is one we no longer
    // offer.
    Adw.ComboRow ac_row {
      title: "Plugged In";
    }

    Adw.ComboRow battery_row {
      title: "On Battery";
    }
  }

  Adw.PreferencesGroup boosts {
    title: "Custom Mode";

    header-suffix: Image {
      icon-name: "help-about-symbolic";
      valign: center;
      // No wattages here on purpose. The three levels were measured at
      // 50/80/100 W in one session and 60/95/115 W in another, with the
      // card's default and maximum unchanged, so the absolute numbers are not
      // something to promise. That they move, and in which direction, is.
      tooltip-text: "These only do anything in the Custom power mode, and only while plugged in — measured directly, not assumed.\n\nGraphics power raises or lowers the card's power limit. On battery it is fixed by the firmware whatever you choose here.\n\nSynapse refuses to let CPU and Graphics both be High. The firmware allows it, so Lucent does too.";

      styles ["dim-label"]
    };

    // Three fixed levels, so these models are set here and never rebuilt --
    // no re-entrancy risk from assigning a model inside a notify handler.
    Adw.ComboRow cpu_boost_row {
      title: "CPU Power";

      model: StringList {
        strings ["Low", "Medium", "High"]
      };
    }

    Adw.ComboRow gpu_boost_row {
      title: "Graphics Power";

      model: StringList {
        strings ["Low", "Medium", "High"]
      };
    }
  }

  Adw.PreferencesGroup fans {
    title: "Fan";

    header-suffix: Image {
      icon-name: "help-about-symbolic";
      valign: center;
      tooltip-text: "A manual speed is a temporary override. The firmware returns to its automatic curve after suspend, and Lucent never puts it back — so it cannot be left low by accident.\n\nThe speed shown is measured, not requested. The fans ramp towards a new setting at roughly 40 RPM per second, so it takes a minute or so to arrive.";

      styles ["dim-label"]
    };

    Adw.SwitchRow fan_manual_row {
      title: "Manual Fan Speed";
    }

    Adw.PreferencesRow fan_speed_row {
      activatable: false;
      sensitive: false;

      child: Box {
        orientation: vertical;
        spacing: 10;
        margin-top: 14;
        margin-bottom: 14;
        margin-start: 14;
        margin-end: 14;

        Box {
          spacing: 12;

          Label {
            label: "Speed";
            hexpand: true;
            xalign: 0;
          }

          Label fan_value {
            width-chars: 10;
            xalign: 1;

            styles ["numeric", "dim-label"]
          }
        }

        Scale fan_speed {
          hexpand: true;
          draw-value: false;

          adjustment: Adjustment {
            // value is load-bearing: GtkAdjustment defaults it to 0 and does
            // not clamp into [lower, upper], so without it the scale starts
            // at 0 and the first write asks the daemon for 0 RPM.
            value: 2200;
            lower: 2200;
            upper: 5600;
            step-increment: 100;
            page-increment: 400;
          };
        }
      };
    }
  }

  Adw.PreferencesGroup live {
    title: "Right Now";

    Adw.ActionRow mode_row {
      title: "Mode";
      subtitle: "Unknown";
    }

    Adw.ActionRow fan_row {
      title: "Fan Speed";
      subtitle: "Unknown";
    }
  }

  Adw.PreferencesGroup unavailable {
    visible: false;

    $LucentDaemonNotice notice {}
  }
}
