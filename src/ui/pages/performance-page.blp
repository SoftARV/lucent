using Gtk 4.0;
using Adw 1;

template $LucentPerformancePage : Adw.PreferencesPage {

  Adw.PreferencesGroup profiles {
    title: "Power Mode";
    description: "Each power source keeps its own mode. Lucent reapplies it after suspend and at startup, which the laptop's firmware otherwise forgets. On battery the graphics power limit is fixed by the firmware, so fewer modes make any difference there.";

    // Models are built in code: the two rows offer different modes, and the
    // stored value has to stay representable even when it is one we no longer
    // offer.
    Adw.ComboRow ac_row {
      title: "Plugged In";
    }

    Adw.ComboRow battery_row {
      title: "On Battery";
    }
  }

  Adw.PreferencesGroup fans {
    title: "Fan";
    description: "A manual speed is a temporary override. The firmware returns to its automatic curve after suspend, and Lucent never puts it back — so it cannot be left low by accident.";

    Adw.SwitchRow fan_manual_row {
      title: "Manual Fan Speed";
    }

    Adw.PreferencesRow fan_speed_row {
      activatable: false;
      sensitive: false;

      child: Box {
        orientation: vertical;
        spacing: 10;
        margin-top: 14;
        margin-bottom: 14;
        margin-start: 14;
        margin-end: 14;

        Box {
          spacing: 12;

          Label {
            label: "Speed";
            hexpand: true;
            xalign: 0;
          }

          Label fan_value {
            width-chars: 10;
            xalign: 1;

            styles ["numeric", "dim-label"]
          }
        }

        Scale fan_speed {
          hexpand: true;
          draw-value: false;

          adjustment: Adjustment {
            // value is load-bearing: GtkAdjustment defaults it to 0 and does
            // not clamp into [lower, upper], so without it the scale starts
            // at 0 and the first write asks the daemon for 0 RPM.
            value: 2200;
            lower: 2200;
            upper: 5600;
            step-increment: 100;
            page-increment: 400;
          };
        }
      };
    }
  }

  Adw.PreferencesGroup live {
    title: "Right Now";

    Adw.ActionRow mode_row {
      title: "Mode";
      subtitle: "Unknown";
    }

    Adw.ActionRow fan_row {
      title: "Fan Speed";
      subtitle: "Unknown";
    }

    Adw.ActionRow boost_row {
      title: "CPU / GPU Boost";
      subtitle: "Unknown";
    }
  }

  Adw.PreferencesGroup unavailable {
    visible: false;

    $LucentDaemonNotice notice {}
  }
}
