using Gtk 4.0;
using Adw 1;

template $LucentWindow : Adw.ApplicationWindow {
  title: "Lucent";
  default-width: 440;
  default-height: 700;
  width-request: 360;
  height-request: 400;

  content: Adw.ToastOverlay toasts {
    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        [end]
        MenuButton {
          icon-name: "open-menu-symbolic";
          menu-model: primary_menu;
          primary: true;
          tooltip-text: "Main Menu";
        }
      }

      content: Adw.ViewStack stack {
        Adw.ViewStackPage {
          name: "lighting";
          title: "Lighting";
          icon-name: "night-light-symbolic";

          child: $LucentLightingPage lighting {};
        }

        Adw.ViewStackPage {
          name: "performance";
          title: "Performance";
          icon-name: "power-profile-performance-symbolic";

          child: $LucentPerformancePage performance {};
        }

        Adw.ViewStackPage {
          name: "battery";
          title: "Battery";
          icon-name: "battery-good-symbolic";

          child: $LucentBatteryPage battery {};
        }
      };

      // The window is narrow by design, where a header switcher would not fit
      // three tabs.
      [bottom]
      Adw.ViewSwitcherBar {
        stack: stack;
        reveal: true;
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: "About Lucent";
      action: "app.about";
    }

    item {
      label: "Quit";
      action: "app.quit";
    }
  }
}
